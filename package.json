{
  "name": "@kaiden-works/shake-ts",
  "version": "0.1.0",
  "description": "kaiden shake 到達クレデンシャル仕様の参照実装",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt 'src/**/*.ts'",
    "format:check": "oxfmt --check 'src/**/*.ts'",
    "lint": "oxlint src",
    "lint:docs": "textlint 'docs/**/*.md' 'examples/**/*.md' README.md",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "textlint": "15.8.0",
    "textlint-rule-prh": "6.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
